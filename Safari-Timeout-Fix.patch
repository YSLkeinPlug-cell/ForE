+        XCTAssertFalse(state.complete(id: expired.id, succeeded: true))
+        XCTAssertEqual(state.pending?.id, retry.id)
+        XCTAssertNil(state.applied)
+        XCTAssertTrue(state.complete(id: retry.id, succeeded: true))
+        XCTAssertEqual(state.applied, inactive)
+        XCTAssertNil(state.failed)
+    }
