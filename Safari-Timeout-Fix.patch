+private final class SchedulerTestEvents: @unchecked Sendable {
+    private let lock = NSLock()
+    private var values: [String] = []
+    private var firstTick = true
+    private var blocked = false
+    private var heartbeatCount = 0
+
+    func append(_ value: String) {
+        lock.lock()
+        defer { lock.unlock() }
+        values.append(value)
+    }
+
+    func snapshot() -> [String] {
+        lock.lock()
+        defer { lock.unlock() }
+        return values
+    }
+
+    func markFirstTick() -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        guard firstTick else { return false }
+        firstTick = false
+        return true
+    }
+
+    func setRequestBlocked(_ value: Bool) {
+        lock.lock()
+        defer { lock.unlock() }
+        blocked = value
+    }
+
+    func isRequestBlocked() -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        return blocked
+    }
+
+    func recordHeartbeatWhileBlocked() -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        guard blocked, heartbeatCount < 3 else { return false }
+        heartbeatCount += 1
+        return true
+    }
+}
