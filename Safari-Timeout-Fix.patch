+final class SafariAgentSchedulerTests: XCTestCase {
+    func testInitializationPrecedesTheFirstSystemRequestAndRunsOffMainThread() {
+        let scheduler = SafariAgentScheduler()
+        let events = SchedulerTestEvents()
+        let requested = expectation(description: "The first system request sees the initializing heartbeat")
+        defer { scheduler.stop() }
+
+        scheduler.start(interval: 60, initialize: {
+            XCTAssertFalse(Thread.isMainThread)
+            events.append("initializing")
+        }, tick: {
+            XCTAssertFalse(Thread.isMainThread)
+            events.append("tick")
+            scheduler.performRequest {
+                XCTAssertFalse(Thread.isMainThread)
+                events.append("request")
+                XCTAssertEqual(events.snapshot(), ["initializing", "tick", "request"])
+                requested.fulfill()
+            }
+        })
+
+        wait(for: [requested], timeout: 2)
+    }
+
+    func testBlockedSystemRequestDoesNotPreventHeartbeatsOrStateResults() {
+        let scheduler = SafariAgentScheduler()
+        let gate = DispatchSemaphore(value: 0)
+        let events = SchedulerTestEvents()
+        let requestEntered = expectation(description: "A synchronous system API entry is blocked")
+        let heartbeats = expectation(description: "Heartbeats continue while the request is blocked")
+        heartbeats.expectedFulfillmentCount = 3
+        let stateResult = expectation(description: "State results still run during the blocked request")
+        let requestExited = expectation(description: "The deliberately blocked test request is released")
+        defer {
+            gate.signal()
+            wait(for: [requestExited], timeout: 2)
+            scheduler.stop()
+        }
+
+        scheduler.start(interval: 0.01, initialize: {}, tick: {
+            if events.markFirstTick() {
+                scheduler.performRequest {
+                    events.setRequestBlocked(true)
+                    requestEntered.fulfill()
+                    gate.wait()
+                    events.setRequestBlocked(false)
+                    requestExited.fulfill()
+                }
+            } else if events.recordHeartbeatWhileBlocked() {
+                XCTAssertFalse(Thread.isMainThread)
+                heartbeats.fulfill()
+            }
+        })
+
+        wait(for: [requestEntered], timeout: 2)
+        scheduler.receiveResult {
+            XCTAssertFalse(Thread.isMainThread)
+            XCTAssertTrue(events.isRequestBlocked())
+            stateResult.fulfill()
+        }
+        wait(for: [heartbeats, stateResult], timeout: 2)
+    }
+
+    func testResultCallbacksShareOrderedStateWithInitializationAndTicks() {
+        let scheduler = SafariAgentScheduler()
+        let finished = expectation(description: "Every result updates the serial agent state in order")
+        var nextResult = -1
+        defer { scheduler.stop() }
+
+        scheduler.start(interval: 60, initialize: {
+            nextResult = 0
+        }, tick: {
+            XCTAssertEqual(nextResult, 0)
+        })
+        for index in 0..<100 {
+            scheduler.receiveResult {
+                XCTAssertFalse(Thread.isMainThread)
+                XCTAssertEqual(nextResult, index)
+                nextResult += 1
+                if index == 99 { finished.fulfill() }
+            }
+        }
+        wait(for: [finished], timeout: 2)
+    }
+}
