+    func testLateCallbackInvalidatesAConfirmedReleaseAndSchedulesFreshInactiveRules() throws {
+        var state = SafariReloadState()
+        let active = SafariRuleSet(domains: ["youtube.com"], activeUntil: now.addingTimeInterval(600), sessionID: UUID())
+        let old = try XCTUnwrap(state.begin(active, now: now, uptime: 100))
