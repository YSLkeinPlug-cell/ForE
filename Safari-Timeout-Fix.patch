+        XCTAssertTrue(state.complete(id: release.id, succeeded: true))
+        XCTAssertFalse(state.shouldReload(inactive))
+
+        XCTAssertFalse(state.complete(id: old.id, succeeded: true))
+        // The framework request cannot be cancelled. A late callback may mean
+        // Safari changed compiled rules after the release was acknowledged.
+        state.invalidateApplied()
+        XCTAssertNil(state.applied)
+        XCTAssertTrue(state.shouldReload(inactive))
+        let freshRelease = try XCTUnwrap(state.begin(inactive, now: now.addingTimeInterval(40), uptime: 140))
+        XCTAssertTrue(state.complete(id: freshRelease.id, succeeded: true))
+        XCTAssertEqual(state.applied, inactive)
+    }
