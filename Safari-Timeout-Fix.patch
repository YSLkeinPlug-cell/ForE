+    func testReceiptRequiresTheExactFreshSnapshotWithoutAReadError() throws {
+        var state = SafariReloadState()
+        let active = SafariRuleSet(domains: ["youtube.com"], activeUntil: now.addingTimeInterval(600), sessionID: UUID())
+        let attempt = try XCTUnwrap(state.begin(active, now: now, uptime: 100))
+        let receipt = SafariRuleReceipt(snapshot: active, generatedAt: now.addingTimeInterval(20))
+        let decoded = try JSONDecoder().decode(SafariRuleReceipt.self, from: JSONEncoder().encode(receipt))
+        XCTAssertTrue(decoded.confirms(attempt))
+        XCTAssertTrue(SafariRuleReceipt(snapshot: active, generatedAt: now.addingTimeInterval(-1)).confirms(attempt))
+        XCTAssertFalse(SafariRuleReceipt(snapshot: active, generatedAt: now.addingTimeInterval(-2)).confirms(attempt),
+                       "A previous extension request cannot confirm the current reload")
+        XCTAssertFalse(SafariRuleReceipt(snapshot: active, generatedAt: now, readError: "App Group unreadable").confirms(attempt))
+        XCTAssertFalse(SafariRuleReceipt(snapshot: SafariRuleSet(), generatedAt: now).confirms(attempt))
+
+        var changed = active
+        changed.domains = ["reddit.com"]
+        XCTAssertFalse(SafariRuleReceipt(snapshot: changed, generatedAt: now).confirms(attempt))
+        changed = active
+        changed.activeUntil = now.addingTimeInterval(601)
+        XCTAssertFalse(SafariRuleReceipt(snapshot: changed, generatedAt: now).confirms(attempt))
+        changed = active
+        changed.sessionID = UUID()
+        XCTAssertFalse(SafariRuleReceipt(snapshot: changed, generatedAt: now).confirms(attempt))
