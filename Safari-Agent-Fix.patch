+    /// A .notFound status describes Service Management's lookup, not whether
+    /// ForE.app exists. A first installation may need register() from this state.
+    /// Only the explicit setup action may repair a stale registration.
+    private func registerServiceIfNeeded() async throws {
+        try validateAgentBundle()
+        let agent = service
+        let initialStatus = agent.status
+        guard initialStatus == .notRegistered || initialStatus == .notFound else { return }
+
+        do {
+            try agent.register()
+        } catch {
+            if requiresApproval(error, service: agent) {
+                throw SafariProtectionError.backgroundApprovalRequired
+            }
+            if agent.status == .enabled { return }
+            guard initialStatus == .notFound else {
+                throw registrationFailure(error, operation: "Registrierung")
+            }
+
+            // Try normal registration first: unregistering a never-registered
+            // service can itself fail. If registration failed from .notFound,
+            // remove this service's stale record before one bounded retry.
+            let firstError = error
+            do {
+                try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, Error>) in
+                    agent.unregister { error in
+                        if let error { continuation.resume(throwing: error) }
+                        else { continuation.resume() }
+                    }
+                }
+            } catch {
+                let failure = error as NSError
+                guard failure.domain == SMAppServiceErrorDomain,
+                      failure.code == kSMErrorJobNotFound else {
+                    throw registrationFailure(error, operation: "Alte Registrierung entfernen; erster Versuch: \(describe(firstError))")
+                }
+            }
+            try Task.checkCancellation()
+            do {
+                try agent.register()
+            } catch {
+                if requiresApproval(error, service: agent) {
+                    throw SafariProtectionError.backgroundApprovalRequired
+                }
+                if agent.status == .enabled { return }
+                throw registrationFailure(error, operation: "Erneute Registrierung")
+            }
+        }
+    }
+
+    private func requiresApproval(_ error: Error, service: SMAppService) -> Bool {
+        let failure = error as NSError
+        return service.status == .requiresApproval
+            || (failure.domain == SMAppServiceErrorDomain && failure.code == kSMErrorLaunchDeniedByUser)
+    }
+
+    private func validateAgentBundle() throws {
+        let bundle = Bundle.main.bundleURL
+        let plistURL = bundle.appendingPathComponent("Contents/Library/LaunchAgents/\(Self.agentPlistName)")
+        guard let data = try? Data(contentsOf: plistURL),
+              let plist = (try? PropertyListSerialization.propertyList(from: data, format: nil)) as? [String: Any],
+              plist["Label"] as? String == "de.fore.safari-agent",
+              plist["BundleProgram"] as? String == "Contents/MacOS/ForE",
+              let arguments = plist["ProgramArguments"] as? [String],
+              Array(arguments.dropFirst()) == ["--safari-agent"] else {
+            throw SafariProtectionError.serviceBundleInvalid("Dienstdatei: \(plistURL.path)")
+        }
+        let executable = bundle.appendingPathComponent("Contents/MacOS/ForE")
+        guard FileManager.default.isExecutableFile(atPath: executable.path) else {
+            throw SafariProtectionError.serviceBundleInvalid("Programmdatei: \(executable.path)")
+        }
+    }
+
+    private func describe(_ error: Error) -> String {
+        let failure = error as NSError
+        return "\(failure.domain) (\(failure.code)): \(failure.localizedDescription)"
+    }
+
+    private func registrationFailure(_ error: Error, operation: String) -> SafariProtectionError {
+        .serviceRegistrationFailed("\(operation): \(describe(error)) App: \(Bundle.main.bundleURL.path)")
     }
 
